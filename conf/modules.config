/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'FASTQC_RAW' {
        publishDir = [
            path: { "${params.outdir}/02_fastqc/original" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC_RAW' {
        ext.prefix = 'multiqc_original_report'
        publishDir = [
            path: { "${params.outdir}/02_multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'TRIMMOMATIC' {
        ext.args2 = { "ILLUMINACLIP:${params.trimmomatic_adapters}:${params.trimmomatic_illuminaclip}" }
        ext.args  = { params.trimmomatic_args ?: 'SLIDINGWINDOW:4:10 TRAILING:3 MINLEN:10' }
        publishDir = [
            [
                path: { "${params.outdir}/01_trim" },
                mode: params.publish_dir_mode,
                pattern: "*.paired.trim*.fastq.gz"
            ],
            [
                path: { "${params.outdir}/01_trim" },
                mode: params.publish_dir_mode,
                pattern: "*.{summary,log}",
                saveAs: { filename -> filename.endsWith('_trim.log') ? null : filename }
            ]
        ]
    }

    withName: 'FASTQC_TRIMMED' {
        publishDir = [
            path: { "${params.outdir}/02_fastqc/trimmed" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC_TRIMMED' {
        ext.prefix = 'multiqc_trimmed_report'
        publishDir = [
            path: { "${params.outdir}/02_multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BOWTIE2_ALIGN' {
        ext.prefix = { "${meta.id}_bowtieoutput" }
        ext.args   = { params.bowtie2_args ?: '--very-sensitive -N 0 -X 500' }
        ext.args2  = '-h --output-fmt sam'
        publishDir = [
            path: { "${params.outdir}/03_align" },
            mode: params.publish_dir_mode,
            enabled: params.publish_align_sam,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PICARD_SORTSAM' {
        ext.prefix = { "${meta.id}_PicardSort" }
        ext.args   = { "--VALIDATION_STRINGENCY ${params.picard_validation_stringency}" }
        publishDir = [
            path: { "${params.outdir}/04_dedup" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'PICARD_MARKDUPLICATES' {
        ext.prefix = { "${meta.id}_PicardDedup" }
        ext.args   = {
            [
                "--VALIDATION_STRINGENCY ${params.picard_validation_stringency}",
                "--REMOVE_DUPLICATES ${params.picard_remove_duplicates}"
            ].join(' ')
        }
        publishDir = [
            [
                path: { "${params.outdir}/04_dedup" },
                mode: params.publish_dir_mode,
                pattern: "*.metrics.txt",
                saveAs: { filename -> filename.endsWith('.metrics.txt') ? "${meta.id}_dup.txt" : filename }
            ],
            [
                path: { "${params.outdir}/04_dedup" },
                mode: params.publish_dir_mode,
                enabled: params.publish_dedup_bam,
                pattern: "*_PicardDedup.bam"
            ]
        ]
    }

    withName: 'SAMTOOLS_MAPQ_FILTER' {
        ext.prefix = { "${meta.id}_PicardDedup_mapqfilt" }
        ext.args   = { "-h -q ${params.mapq_threshold} --output-fmt sam" }
        publishDir = [
            path: { "${params.outdir}/05_mapq_filter" },
            mode: params.publish_dir_mode,
            enabled: params.publish_mapq_sam,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_VIEW_BAM' {
        ext.prefix = { "${meta.id}" }
        ext.args   = '-bh --output-fmt bam'
        publishDir = [
            path: { "${params.outdir}/06_index_bam" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/06_index_bam" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DEEPTOOLS_BAMCOVERAGE' {
        ext.prefix = { "${meta.id}" }
        ext.args   = { "--normalizeUsing ${params.bamcoverage_norm}" }
        publishDir = [
            path: { "${params.outdir}/06_index_bam" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.replaceAll(/\.bigWig$/, '.bw') }
        ]
    }

    withName: 'HOMER_MAKETAGDIRECTORY' {
        publishDir = [
            path: { "${params.outdir}/07_ucsc" },
            mode: params.publish_dir_mode,
            pattern: "*_tagdir",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.replaceAll(/_tagdir$/, '') }
        ]
    }

    withName: 'HOMER_MAKEUCSCFILE' {
        ext.prefix = { "${meta.id}.ucsc" }
        publishDir = [
            path: { "${params.outdir}/07_ucsc/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'UCSC_BEDGRAPHTOBIGWIG' {
        publishDir = [
            path: { "${params.outdir}/08_bigwig" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.replaceAll(/\.bigWig$/, '.bw') }
        ]
    }

}
