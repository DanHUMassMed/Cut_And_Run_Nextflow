/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'FASTQC_RAW' {
        publishDir = [
            path: { "${params.outdir}/02_fastqc/original" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MULTIQC_RAW' {
        ext.prefix = 'multiqc_original_report'
        publishDir = [
            path: { "${params.outdir}/02_multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'TRIMMOMATIC' {
        ext.args2 = { params.trimmomatic_illuminaclip ?: '2:25:7:1:true' }
        ext.args  = { params.trimmomatic_args ?: 'SLIDINGWINDOW:4:10 TRAILING:3 MINLEN:10' }
        publishDir = [
            path: { "${params.outdir}/01_trim" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FASTQC_TRIMMED' {
        publishDir = [
            path: { "${params.outdir}/02_fastqc/trimmed" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MULTIQC_TRIMMED' {
        ext.prefix = 'multiqc_trimmed_report'
        publishDir = [
            path: { "${params.outdir}/02_multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BOWTIE2_ALIGN' {
        ext.args = { params.bowtie2_args ?: '--very-sensitive -N 0 -X 500' }
        publishDir = [
            path: { "${params.outdir}/03_align" },
            mode: params.publish_dir_mode,
            enabled: params.publish_align_sam
        ]
    }

    withName: 'PICARD_DEDUP' {
        publishDir = [
            [
                path: { "${params.outdir}/04_dedup" },
                mode: params.publish_dir_mode,
                pattern: "*_dup.txt"
            ],
            [
                path: { "${params.outdir}/04_dedup" },
                mode: params.publish_dir_mode,
                enabled: params.publish_dedup_bam,
                pattern: "*_PicardDedup.bam"
            ]
        ]
    }

    withName: 'SAMTOOLS_MAPQ_FILTER' {
        ext.args = { "-q ${params.mapq_threshold}" }
        publishDir = [
            path: { "${params.outdir}/05_mapq_filter" },
            mode: params.publish_dir_mode,
            enabled: params.publish_mapq_sam
        ]
    }

    withName: 'INDEX_BAM' {
        ext.args = { "--normalizeUsing ${params.bamcoverage_norm}" }
        publishDir = [
            [
                path: { "${params.outdir}/06_index_bam" },
                mode: params.publish_dir_mode,
                pattern: "*.bam*"
            ],
            [
                path: { "${params.outdir}/08_bigwig/deepTools" },
                mode: params.publish_dir_mode,
                pattern: "*.bw"
            ]
        ]
    }

    withName: 'HOMER_UCSC' {
        ext.args2 = ''
        publishDir = [
            path: { "${params.outdir}/07_homer" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'UCSC_BEDGRAPHTOBIGWIG' {
        publishDir = [
            path: { "${params.outdir}/08_bigwig/UCSC" },
            mode: params.publish_dir_mode
        ]
    }

}
