/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    CUT&RUN Nextflow Config File
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default configuration options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default parameters
params {
    // Experiment / Input options (paired-end reads)
    experiment                = 'cutandrun'
    fastq                     = "${launchDir}/data/fastq/*_R{1,2}_001.fastq.gz"

    // Trimmomatic options
    trimmomatic_adapters      = "${projectDir}/assets/adapters/TruSeq3-PE-2.fa"
    trimmomatic_illuminaclip  = '2:25:7:1:true'
    trimmomatic_slidingwindow = '4:10'
    trimmomatic_trailing      = 3
    trimmomatic_minlen        = 10

    // MultiQC options
    multiqc_config            = null
    multiqc_title             = null
    multiqc_logo              = null

    // Output & Boilerplate options
    outdir                    = "${launchDir}/results"
    publish_dir_mode          = 'copy'
    email                     = null
    help                      = false
    trace_report_suffix       = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

// Enable Docker by default for local execution and mount projectDir for adapter access
docker.enabled    = true
docker.runOptions = "-u \$(id -u):\$(id -g) -v '${projectDir}:${projectDir}'"

// Load base resource configuration
includeConfig 'conf/base.config'

// Profiles for different execution environments
profiles {
    debug {
        dumpHashes                                   = true
        process.beforeScript                         = 'echo $HOSTNAME'
        cleanup                                      = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled        = true
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        conda.channels       = ['conda-forge', 'bioconda']
        apptainer.enabled    = false
    }
    mamba {
        conda.enabled        = true
        conda.useMamba       = true
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        apptainer.enabled    = false
    }
    docker {
        docker.enabled       = true
        conda.enabled        = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        apptainer.enabled    = false
        docker.runOptions    = "-u \$(id -u):\$(id -g) -v '${projectDir}:${projectDir}'"
    }
    arm64 {
        process.arch            = 'arm64'
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions = "-u \$(id -u):\$(id -g) -v '${projectDir}:${projectDir}' --platform=linux/amd64"
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        conda.enabled        = false
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
    }
    test {
        includeConfig 'conf/test.config'
    }
}

// Prevent local Python/R/Julia libraries from conflicting with container environments
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Strict bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit
    "pipefail"    //   with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'cutandrun'
    contributors    = [
        [
            name: 'DanHUMassMed',
            affiliation: 'UMass Chan Medical School',
            email: 'daniel.higgins@umassmed.edu',
            github: '',
            contribution: ['author', 'maintainer'],
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/DanHUMassMed/Cut_And_Run_Nextflow'
    description     = 'Nextflow CUT&RUN analysis pipeline for quality control and trimming (FastQC, Trimmomatic, MultiQC)'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.4'
    version         = '1.0.0'
    doi             = ''
}

// Load modules.config for DSL2 module-specific options and publishDir settings
includeConfig 'conf/modules.config'
