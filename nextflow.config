/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    CUT&RUN Upstream Base Pipeline Nextflow Config File
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default configuration options for HPC (LSF) and local/container compute environments
----------------------------------------------------------------------------------------
*/

// Global default parameters
params {
    // =========================================================================
    // Experiment & Input / Output Paths (Required in config/experiment.config)
    // =========================================================================
    experiment                     = null
    fastq_dir                      = null
    outdir                         = null
    samplesheet                    = "${launchDir}/config/samplesheet.csv"
    rclone_remote                  = null

    // =========================================================================
    // Step Toggles (Turn individual upstream processing steps on/off)
    // =========================================================================
    // Step 00: Raw FASTQ QC (02_fastqc/original & 02_multiqc)
    run_raw_fastqc                 = true

    // Step 01: Adapter Trimming with Trimmomatic (01_trim)
    run_trimmomatic                = true

    // Step 02: Trimmed FASTQ QC (02_fastqc/trimmed & 02_multiqc)
    run_trimmed_fastqc             = true

    // Step 03: Genome Alignment with Bowtie2 (03_align)
    run_bowtie2_align              = true

    // Step 04: Coordinate Sorting & Deduplication with Picard (04_dedup)
    run_picard_dedup               = true

    // Step 05: Low-Quality Read Filtering with samtools (05_mapq_filter)
    run_mapq_filter                = true

    // Step 06: BAM Indexing & deepTools RPKM BigWig (06_index_bam)
    run_index_bam                  = true

    // Step 07: HOMER Tag Directory & UCSC bedGraph (07_ucsc)
    run_homer_ucsc                 = true

    // Step 08: UCSC bedGraphToBigWig Conversion (08_bigwig)
    run_ucsc_bigwig                = true

    // Output publishing controls for large intermediate files
    publish_align_sam              = true
    publish_dedup_bam              = false
    publish_mapq_sam               = true

    // =========================================================================
    // Input Globs (Primary FASTQ input & step-skip fallbacks)
    // =========================================================================
    input_fastq                    = null
    input_trimmed_fastq            = null
    input_align_sam                = null
    input_dedup_bam                = null
    input_mapq_sam                 = null
    input_bedgraph                 = null

    // =========================================================================
    // HPC Reference & Tool Paths (C. elegans ce11_ws245 defaults)
    // =========================================================================
    trimmomatic_dir                = "/pi/thomas.fazzio-umw/conda/pkgs/trimmomatic-0.39-hdfd78af_2/share/trimmomatic-0.39-2"
    trimmomatic_jar                = "${params.trimmomatic_dir}/trimmomatic.jar"
    trimmomatic_adapters           = "${params.trimmomatic_dir}/adapters/TruSeq3-PE-2.fa"
    bowtie2_index                  = "/share/data/umw_biocore/genome_data/c_elegans/ce11_ws245/ce11_ws245"
    chrom_sizes                    = "/share/data/umw_biocore/genome_data/c_elegans/ce11_ws245/ce11_ws245.chrom.sizes"
    picard_jar                     = "/pi/thomas.fazzio-umw/Sarah/picard-tools-2.5.0/picard.jar"
    homer_bin_dir                  = "\$HOME/software/homer/bin"
    multiqc_module                 = ""

    // =========================================================================
    // Tool-Specific Parameters
    // =========================================================================
    // Step 01: Trimmomatic parameters
    trimmomatic_illuminaclip       = "2:25:7:1:true"
    trimmomatic_args               = "SLIDINGWINDOW:4:10 TRAILING:3 MINLEN:10"

    // Step 03: Bowtie2 parameters
    bowtie2_args                   = "--very-sensitive -N 0 -X 500"

    // Step 04: Picard parameters
    picard_validation_stringency   = "LENIENT"
    picard_remove_duplicates       = true

    // Step 05: samtools MAPQ filter
    mapq_threshold                 = 10

    // Step 06: deepTools bamCoverage
    bamcoverage_norm               = "RPKM"

    // =========================================================================
    // Boilerplate Options
    // =========================================================================
    publish_dir_mode               = 'copy'
    email                          = null
    help                           = false
    trace_report_suffix            = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

// Enable Singularity by default on HPC for containerized processes (e.g., MULTIQC)
singularity.enabled    = true
singularity.autoMounts = true

// Load base resource configuration and DSL2 module-specific options
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Note: experiment-specific configuration is passed via -c config/experiment.config

// Profiles for different execution environments
profiles {
    debug {
        dumpHashes                                   = true
        process.beforeScript                         = 'echo $HOSTNAME'
        cleanup                                      = false
        nextflow.enable.configProcessNamesValidation = true
    }
    local {
        singularity.enabled  = false
        process.executor     = 'local'
        process.module       = null
    }
    hpc {
        docker.enabled       = false
        singularity.enabled  = false
        conda.enabled        = false
    }
    conda {
        conda.enabled        = true
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        conda.channels       = ['conda-forge', 'bioconda']
        apptainer.enabled    = false
    }
    mamba {
        conda.enabled        = true
        conda.useMamba       = true
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        apptainer.enabled    = false
    }
    docker {
        docker.enabled       = true
        conda.enabled        = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
        apptainer.enabled    = false
        docker.runOptions    = "-u \$(id -u):\$(id -g) -v '${projectDir}:${projectDir}' -v '${params.fastq_dir}:${params.fastq_dir}'"
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        conda.enabled        = false
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
    }
}

// Prevent local Python/R/Julia libraries from conflicting with container environments
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Strict bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit
    "pipefail"    //   with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'cutandrun-base'
    contributors    = [
        [
            name: 'DanHUMassMed',
            affiliation: 'UMass Chan Medical School',
            email: 'daniel.higgins@umassmed.edu',
            github: '',
            contribution: ['author', 'maintainer'],
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/DanHUMassMed/Cut_And_Run_Analysis'
    description     = 'Nextflow CUT&RUN upstream base pipeline (HPC)'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.4'
    version         = '1.0.0'
    doi             = ''
}

